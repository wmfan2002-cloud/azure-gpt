+func hasProviderRecovery(ctx context.Context) bool {
+	runs, _ := ctx.Value(triedKey{}).(mwRuns)
+	return len(runs.recovery) > 0
+}
+
+var recoveryItemID = regexp.MustCompile(`\b(?:rs|msg|fc|ctc|ws|cmp)_[A-Za-z0-9_-]{1,160}\b`)
+
+// Only specific resource/encryption validation failures reach a plugin.
+// Generic 5xx, timeouts, auth, quota and safety refusals are not repairable.
+func recoveryFailure(status int, raw []byte) (gwmw.ProviderFailure, bool) {
+	if status < 400 || status == 401 || status == 403 || status == 429 || status == 408 || status == 504 || len(raw) > 32768 {
+		return gwmw.ProviderFailure{}, false
+	}
+	s := strings.ToLower(string(raw))
+	kind := ""
+	switch {
+	case strings.Contains(s, "created under a different") && strings.Contains(s, "azure openai resource"):
+		kind = "foreign_resource"
+	case strings.Contains(s, "invalid_encrypted_content"),
+		strings.Contains(s, "encrypted content could not be decrypted or parsed"),
+		strings.Contains(s, "encrypted content") && strings.Contains(s, "could not be verified"),
+		strings.Contains(s, "could not decrypt") && strings.Contains(s, "encrypted_content"),
+		strings.Contains(s, "invalid encrypted summary"):
+		kind = "invalid_encrypted_content"
+	}
+	if kind == "" {
+		return gwmw.ProviderFailure{}, false
+	}
+	return gwmw.ProviderFailure{Kind: kind, Status: status, Attempt: 1, OutputStarted: false, ItemID: recoveryItemID.FindString(string(raw))}, true
+}
+
+func providerRecovery(ctx context.Context, p provider.Provider, model string, body []byte, failure gwmw.ProviderFailure) ([]byte, bool) {
+	runs, _ := ctx.Value(triedKey{}).(mwRuns)
+	to := gwmw.To{ID: p.ID, Name: p.Name, Account: accountAgent(p), Model: model, RecoverySupported: true}
+	for _, t := range runs.recovery {
+		if repaired, handled := t.ProviderError(body, to, failure); handled {
+			return repaired, true
+		}
+	}
+	return nil, false
+}
