+// HasProviderRecovery distinguishes a chain with a recovery hook from one
+// which only observes or transforms ordinary traffic.
+func (r *Run) HasProviderRecovery() bool {
+	if r != nil {
+		for _, m := range r.set.list {
+			if m.hasProvErr {
+				return true
+			}
+		}
+	}
+	return false
+}
+
+// ProviderError accepts the first explicit recovery decision. The gateway
+// owns the retry limit and ensures nothing was delivered or cancelled.
+func (r *Run) ProviderError(body []byte, to gwmw.To, failure gwmw.ProviderFailure) ([]byte, bool) {
+	if !r.HasProviderRecovery() {
+		return nil, false
+	}
+	defer r.letGo()
+	for i, m := range r.set.list {
+		if !m.hasProvErr {
+			continue
+		}
+		in, ctx, err := r.acquire(i)
+		if err != nil {
+			m.fail("onProviderError", err)
+			continue
+		}
+		for _, field := range []struct {
+			name  string
+			value any
+		}{{"provider", to}, {"failure", failure}} {
+			var b []byte
+			var v moejs.Value
+			b, err = json.Marshal(field.value)
+			if err == nil {
+				v, err = in.rt.ParseJSON(b)
+			}
+			if err == nil {
+				err = in.rt.Realm().SetV(ctx, in.rt.Realm().KeyFromGoString(field.name), v)
+			}
+			if err != nil {
+				break
+			}
+		}
+		var out []byte
+		if err == nil {
+			out, err = r.apply(i, m.onProvErr, requestLimit, body, nil)
+		}
+		// A failure marker never leaks into a subsequent ordinary provider try.
+		_ = in.rt.Realm().SetV(ctx, in.rt.Realm().KeyFromGoString("failure"), moejs.Undefined())
+		if err != nil {
+			m.fail("onProviderError", err)
+			continue
+		}
+		if len(out) == 0 {
+			continue
+		}
+		var decision struct {
+			Action string          `json:"action"`
+			Body   json.RawMessage `json:"body"`
+		}
+		if json.Unmarshal(out, &decision) != nil {
+			continue
+		}
+		if decision.Action == "stop" {
+			return nil, true
+		}
+		if decision.Action != "retry" {
+			continue
+		}
+		var original, repaired map[string]any
+		if json.Unmarshal(body, &original) != nil || json.Unmarshal(decision.Body, &repaired) != nil || repaired == nil {
+			m.fail("onProviderError", errors.New("retry requires an object body"))
+			return nil, true
+		}
+		if reflect.DeepEqual(original, repaired) {
+			return nil, true
+		}
+		// Recovery may change history/storage, not model, tools, effort, limits
+		// or any other request settings. Compare semantic JSON, not whitespace.
+		for _, obj := range []map[string]any{original, repaired} {
+			delete(obj, "input")
+			delete(obj, "store")
+			delete(obj, "previous_response_id")
+		}
+		if !reflect.DeepEqual(original, repaired) {
+			m.fail("onProviderError", errors.New("recovery changed fields outside input/store/previous_response_id"))
+			return nil, true
+		}
+		return decision.Body, true
+	}
+	return nil, false
+}
